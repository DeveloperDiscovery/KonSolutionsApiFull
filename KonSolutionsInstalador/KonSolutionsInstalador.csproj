<Project Sdk="Microsoft.NET.Sdk">
  <!-- Instalador de la API (servicio de Windows KonSolutionsApi). Un .exe de consola (pide permisos de administrador) que copia la API, pide la configuracion, la comprueba, crea el servicio,
       abre el puerto del firewall, lo inicia y verifica que /health responde. Se publica junto con la API con publicar.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Instalador</AssemblyName>
    <RootNamespace>KonSolutionsInstalador</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
  </ItemGroup>
</Project>
